{
  // ==========================================================================
  // VSCode/Windsurf Settings for Java Language Server Integration
  // ==========================================================================
  // Copy this file to .vscode/settings.json in your project
  // Or copy these settings to your workspace/user settings
  //
  // Requires the "Extension Pack for Java" (vscjava.vscode-java-pack), which
  // bundles Red Hat "Language Support for Java" (Eclipse JDT.LS). Optionally
  // install the Checkstyle extension (shengchen.vscode-checkstyle) to surface
  // checkstyle.xml diagnostics inline.
  // ==========================================================================

  // ---------------------------------------------------------------------------
  // Java Runtime (use JDK 17 — SpotBugs crashes on newer JDKs)
  // ---------------------------------------------------------------------------
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-17",
      "path": "/usr/lib/jvm/java-17-openjdk-amd64",
      "default": true
    }
  ],

  // ---------------------------------------------------------------------------
  // Project Model (pom.xml is read by the language server — the clangd /
  // compile_commands.json analogue; no separate index file to generate)
  // ---------------------------------------------------------------------------
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.maven.enabled": true,
  "java.maven.downloadSources": true,
  "java.eclipse.downloadSources": true,
  "java.compile.nullAnalysis.mode": "automatic",

  // ---------------------------------------------------------------------------
  // Checkstyle Integration (style / naming / braces — clang-format analogue)
  // ---------------------------------------------------------------------------
  "java.checkstyle.configuration": "${workspaceFolder}/checkstyle.xml",
  "java.checkstyle.version": "10.12.7",
  "java.checkstyle.autocheck": true,

  // ---------------------------------------------------------------------------
  // Formatting (Java end-of-line / K&R brace style, format on save)
  // ---------------------------------------------------------------------------
  "java.format.enabled": true,
  "java.format.settings.profile": "GoogleStyle",
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  // ---------------------------------------------------------------------------
  // Inlay Hints
  // ---------------------------------------------------------------------------
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.inlayHints.fontSize": 11,
  "editor.inlayHints.padding": true,
  "java.inlayHints.parameterNames.enabled": "all",

  // ---------------------------------------------------------------------------
  // File Associations
  // ---------------------------------------------------------------------------
  "files.associations": {
    "*.java": "java",
    "pom.xml": "xml",
    "checkstyle.xml": "xml",
    "pmd-ruleset.xml": "xml",
    "spotbugs-exclude.xml": "xml"
  },

  // ---------------------------------------------------------------------------
  // Exclude from Search/Watch (Maven build output)
  // ---------------------------------------------------------------------------
  "files.watcherExclude": {
    "**/target/**": true,
    "**/.git/**": true
  },
  "search.exclude": {
    "**/target": true
  }
}
